# data (raw + processed pulled from external sources, not committed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# ...except the datasheet: hand-authored content, not a regenerable derived
# artifact like the multi-GB CSVs above -- worth tracking so it survives a
# fresh clone.
!data/processed/datasheet.json

# grounding-experiment output (regenerate via `make grounding`)
results/

# python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# env / secrets
.env
*.env.local

# OS
.DS_Store
