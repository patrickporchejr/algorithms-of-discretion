# data (raw + processed pulled from external sources, not committed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# precomputed audit artifacts (regenerate via `make results`; revisit
# whether to commit these once we're deploying the demo -- they're small
# relative to data/, unlike the raw/processed CSVs)
results/

# python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/

# env / secrets
.env
*.env.local

# OS
.DS_Store
