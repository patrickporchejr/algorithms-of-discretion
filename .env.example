# Copy this file to .env (gitignored) and fill in the keys you need.
# .env is loaded by the Python pipeline (python-dotenv) and read directly
# via Sys.getenv() on the R side -- nothing here is committed.

# Required for `make all` (python/01_fetch_census.py pulls ACS covariates).
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional -- only needed for `make grounding` (the "LLM Grounding Test"
# dashboard tab, see duboisR::run_grounding_experiment()). Set at least one;
# every provider with a key set here gets run and compared. Get keys at:
#   Anthropic: https://console.anthropic.com/settings/keys
#   OpenAI:    https://platform.openai.com/api-keys
#   Gemini:    https://aistudio.google.com/apikey
#   Grok/xAI:  https://console.x.ai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
